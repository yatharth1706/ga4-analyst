# Copy to backend/.env and fill in. Never commit .env.

# LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# BigQuery
GOOGLE_CLOUD_PROJECT=
# Local dev: absolute path to the service-account key file (keep it outside the repo)
GOOGLE_APPLICATION_CREDENTIALS=
# Deploy only (Vercel): the key file's JSON contents
GCP_SERVICE_ACCOUNT_JSON=
BQ_LOCATION=US
BQ_MAX_BYTES_BILLED=3000000000
BQ_TIMEOUT_SECONDS=30
BQ_MAX_ROWS=500
MODEL_MAX_ROWS=100

