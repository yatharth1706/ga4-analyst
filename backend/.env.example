# Copy to backend/.env and fill in. Never commit .env.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=

# Local: absolute path to the service-account key file (keep it outside the repo)
GOOGLE_APPLICATION_CREDENTIALS=
# Deployed (Vercel): the key file's JSON contents instead of a path
GCP_SERVICE_ACCOUNT_JSON=
